// Checks src/lib/protocol.ts against independent data, so the demo on the page hashes
// exactly as the protocol specifies:
//   npm run test:protocol
//
// Sources: RFC 6962 reference roots from transparency-dev/merkle (Apache-2.0, commit
// c39fbf3, testonly/constants.go); commitment, salted-leaf and inclusion-path vectors
// generated by the Immutal Python reference implementation.
import assert from 'node:assert/strict';
import { test } from 'node:test';
import {
  anchorCommitment, canonicalise, fromHex, inclusionPath, leafHash, perfectLevels, rootFromPath, sha256, toHex,
  treeRoot,
} from '../src/lib/protocol.ts';

const NO_SALT = new Uint8Array();
const hexes = (list: Uint8Array[]) => list.map(toHex);

test('RFC 6962 reference roots, sizes 0 to 8', async () => {
  const inputs = ['', '00', '10', '2021', '3031', '40414243', '5051525354555657', '606162636465666768696a6b6c6d6e6f'];
  const roots = [
    'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855',
    '6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d',
    'fac54203e7cc696cf0dfcb42c92a1d9dbaf70ad9e621f4bd8d98662f00e3c125',
    'aeb6bcfe274b70a14fb067a5e5578264db0fa9b51af5e0ba159158f329e06e77',
    'd37ee418976dd95753c1c73862b9398fa2a2cf9b4ff0fdfe8b30cd95209614b7',
    '4e3bbb1f7b478dcfe71fb631631519a3bca12c9aefca1612bfce4c13a86264d4',
    '76e67dadbcdf1e10e1b74ddc608abd2f98dfb16fbce75277b5232a127f2087ef',
    'ddb89be403809e325750d3d263cd78929c2942b7942a34b77e122c9594a74c8c',
    '5dc9da79a70659a9ad559cb701ded9a2ab9d823aad2f4960cfe370eff4604328',
  ];
  // RFC 6962 hashes a leaf as SHA-256(0x00 || input), which is leafHash with an empty salt.
  const leaves = await Promise.all(inputs.map(input => leafHash(NO_SALT, fromHex(input))));
  for (let size = 0; size <= 8; size++) {
    assert.equal(toHex(await treeRoot(leaves.slice(0, size))), roots[size], `size ${size}`);
  }
});

test('salted leaf matches the Python reference', async () => {
  const entry = '{"captured_at":"2026-10-26T03:15:00Z","device":"LOGGER-02","kind":"reading","period":298,'
    + '"received_at":"2026-10-26T03:15:30Z","seq":7,"site":"KUL-WH1","temp_cC":950,"v":1}';
  const salt = fromHex('81f27b16200c3cc1587b05830fa8ec22');
  assert.equal(toHex(await leafHash(salt, entry)), 'e2ee003f99c3b33c8ba8405a48093c1d83e7a885d1017e3f1aa31eb2425073e9');
});

test('canonicalise sorts members and escapes like RFC 8785', async () => {
  // Same entry, members given out of order: the canonical text is the one the vector hashes.
  const entry = canonicalise({
    v: 1, temp_cC: 950, site: 'KUL-WH1', seq: 7, received_at: '2026-10-26T03:15:30Z', period: 298,
    kind: 'reading', device: 'LOGGER-02', captured_at: '2026-10-26T03:15:00Z',
  });
  assert.equal(entry, '{"captured_at":"2026-10-26T03:15:00Z","device":"LOGGER-02","kind":"reading","period":298,'
    + '"received_at":"2026-10-26T03:15:30Z","seq":7,"site":"KUL-WH1","temp_cC":950,"v":1}');
  // RFC 8785 section 3.2.2.2: short escapes, \u00hh for other controls, DEL and U+2028 literal.
  assert.equal(canonicalise({ a: '\b\t\n\f\r"\\\u000f\u001f\u007f é/' }), '{"a":"\\b\\t\\n\\f\\r\\"\\\\\\u000f\\u001f\u007f é/"}');
  // Member names sort by UTF-16 code unit, so the astral emoji (a surrogate pair) precedes U+FB33.
  assert.equal(canonicalise({ '\ufb33': 1, '\u{1F600}': 2, '\u20ac': 3, '\r': 4, '1': 5 }),
    '{"\\r":4,"1":5,"\u20ac":3,"\u{1F600}":2,"\ufb33":1}');
  assert.throws(() => canonicalise({ x: 1.5 }), /safe integers/);
});

test('anchor commitments match the Python reference', async () => {
  const vectors = [
    { period: 0, size: 0, root: '58f3a9fd2140a8feb98d1b739dae4eff41d703b783394079cfeaeaa8e5f5a46d', salt: '77b0fe9e71d7e728881c685d2dee484e', commitment: 'ba3da5159f68946927aee288eb4424e9b4d53f318621e3f82dbdb3056bab1dd7' },
    { period: 298, size: 21, root: '519f521b00fd5152d331db28ef85ce03a1c5bb92944e38bc4a01a9a7de3105c2', salt: 'c4b0a0157c8fb0347e184ccf655519c3', commitment: 'afd11d60beca7273391c66827394fe261da110f099692721962f90b2222d9c2d' },
    { period: 9007199254740991, size: 100000, root: '350b28a368c0bc0d1a8d0ff4bafeee1d3953b4983e1dbaeebcbfa7e8c86764b5', salt: '5b7932c094ac65c1f4ce62859787a3af', commitment: '65ecda4ee76942a37bd88cad63ebb02e21e5350f7283a2d0f612d9a2c8998127' },
  ];
  for (const v of vectors) {
    assert.equal(toHex(await anchorCommitment(v.period, v.size, fromHex(v.root), fromHex(v.salt))), v.commitment);
  }
  await assert.rejects(async () => anchorCommitment(-1, 0, fromHex(vectors[0].root), fromHex(vectors[0].salt)), /non-negative/);
});

test('inclusion paths match the Python reference and rebuild the root', async () => {
  const leavesOf = (n: number) => Promise.all(Array.from({ length: n }, (_, i) => leafHash(NO_SALT, new Uint8Array(3).fill(i))));
  const cases = {
    '7:3': { root: '2f03cc5b26727b4848c21c506cd720c1637d940b1dfd3f2b0ed20c0c02c6f25e', path: ['7e86d2ef801a405df86260a535724abea3f1228fb2db064a2531590e281e2a94', 'a2a90e58478f28cbf45e91ea2993b4cb319aa72bd34bd34dcf4310ed167ce29f', 'b28121a8f7e086153506f4f2d13da1a5b0ac1df1031bb9590784faf305ece98e'] },
    '9:8': { root: '17d15d53ee5b8773443541d0969dc577cbb0559d12f44d90f4d1ae5ee02e8422', path: ['c88ad3f5c0edf360dee2299dc572423a0ba995aeeb0c0821ff1e4413d42505c1'] },
    '8:5': { root: 'c88ad3f5c0edf360dee2299dc572423a0ba995aeeb0c0821ff1e4413d42505c1', path: ['d907d820a48a81770c9ad4cf24d2e024e3d814843d58829e258962b9d3535fc7', 'd2c0b8583bfffd1280bda619157ad4ca54a4873279ea445d0d34e05cb5f6fdf1', '178cbab53f812b6688ce963e2abe63cc3ca7f6b4afa1f58db651f0f3dcb8f7cb'] },
  };
  for (const [key, expected] of Object.entries(cases)) {
    const [n, index] = key.split(':').map(Number);
    const leaves = await leavesOf(n);
    assert.equal(toHex(await treeRoot(leaves)), expected.root, key);
    assert.deepEqual(hexes(await inclusionPath(leaves, index)), expected.path, key);
  }
  // Every index of every tree up to 17 leaves rebuilds its root, and a proof does not rebuild
  // it for a different leaf.
  let sizeClaimsAccepted = 0;
  for (let n = 1; n <= 17; n++) {
    const leaves = await leavesOf(n);
    const root = await treeRoot(leaves);
    for (let i = 0; i < n; i++) {
      const path = await inclusionPath(leaves, i);
      assert.equal(toHex(await rootFromPath(i, n, leaves[i], path)), toHex(root), `${n}:${i}`);
      assert.notEqual(toHex(await rootFromPath(i, n, await sha256(leaves[i]), path)), toHex(root), `${n}:${i} wrong leaf`);
      // The bare RFC 9162 check does not authenticate the tree size: for many leaves the same
      // path also rebuilds the root for a tree one leaf larger (the E9 finding). Binding the size
      // inside the anchor commitment is what rejects those claims.
      const larger = await rootFromPath(i, n + 1, leaves[i], path).catch(() => null);
      if (larger && toHex(larger) === toHex(root)) {
        sizeClaimsAccepted++;
        const batchSalt = new Uint8Array(16);
        assert.notEqual(toHex(await anchorCommitment(1, n, root, batchSalt)), toHex(await anchorCommitment(1, n + 1, root, batchSalt)));
      }
    }
  }
  assert.ok(sizeClaimsAccepted > 0, 'expected the bare proof check to accept some size-plus-one claims');
});

test('perfectLevels agrees with the RFC 9162 root', async () => {
  const leaves = await Promise.all(Array.from({ length: 8 }, (_, i) => leafHash(NO_SALT, new Uint8Array(2).fill(i))));
  const levels = await perfectLevels(leaves);
  assert.deepEqual(levels.map(level => level.length), [8, 4, 2, 1]);
  assert.equal(toHex(levels[3][0]), toHex(await treeRoot(leaves)));
  await assert.rejects(perfectLevels(leaves.slice(0, 6)), /power-of-two/);
});

test('one edited record changes the commitment, and salts hide equal records', async () => {
  const salts = [fromHex('00112233445566778899aabbccddeeff'), fromHex('ffeeddccbbaa99887766554433221100')];
  const entry = canonicalise({ kind: 'reading', temp_cC: 980, seq: 0 });
  const edited = canonicalise({ kind: 'reading', temp_cC: 590, seq: 0 });
  const batchSalt = fromHex('5b7932c094ac65c1f4ce62859787a3af');
  const commit = async (text: string) => {
    const leaves = [await leafHash(salts[0], text), await leafHash(salts[1], entry)];
    return toHex(await anchorCommitment(7, 2, await treeRoot(leaves), batchSalt));
  };
  assert.notEqual(await commit(entry), await commit(edited));
  // Identical content under different salts gives different leaves, so a bundle holder
  // cannot test a guess about a neighbouring record against its sibling hash.
  assert.notEqual(toHex(await leafHash(salts[0], entry)), toHex(await leafHash(salts[1], entry)));
});
